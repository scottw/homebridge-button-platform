{
  "name": "homebridge-button-platform-22",
  "displayName": "Button Platform",
  "version": "2.1.0",
  "description": "A Homebridge platform plugin (for Node v22+) to create virtual buttons that respond to HTTP requests from things like Shelly or an Elgato Stream Deck",
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "button",
    "shelly",
    "stream deck",
    "virtual button",
    "http"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottw/homebridge-button-platform.git"
  },
  "bugs": {
    "url": "https://github.com/scottw/homebridge-button-platform/issues"
  },
  "homepage": "https://github.com/scottw/homebridge-button-platform#readme",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "build": "rm -rf dist && tsc",
    "dev": "npm run build && homebridge -I -D -U src/test/hbConfig -P .",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "homebridge": "^2.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
